# Required. Live search, contents, and the recommendation all use this key.
# Create one at https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Optional. Used only to read a nameplate photo. The comparison itself needs Exa.
# If both are set, OpenAI is used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides for the nameplate photo.
OPENAI_VISION_MODEL=gpt-4o-mini
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
